# Claude writes the lyrics (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs Music renders the song with vocals (https://elevenlabs.io). Without it, dev mode plays a placeholder jingle.
ELEVENLABS_API_KEY=

# Stripe payments. Without STRIPE_SECRET_KEY, local dev skips payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order storage (Upstash Redis). Without it, orders are saved to .data/ locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Audio file storage (Vercel Blob). Without it, audio is saved to .data/ locally.
BLOB_READ_WRITE_TOKEN=

# "Your song is ready" emails (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="SongGift <songs@yourdomain.com>"

# Public URL of the site, used in emails, QR codes and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the /admin dashboard (orders, revenue, sales by source, retry failed songs)
ADMIN_PASSWORD=

# Shown in the footer, legal pages and error messages
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_BUSINESS_NAME=SongGift

# Ad pixels (optional). Fire Lead, InitiateCheckout and Purchase events.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
