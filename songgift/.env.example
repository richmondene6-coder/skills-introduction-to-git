# ============================================================
# SongGift settings: fill in your own values after the = sign
# ============================================================
# HOW TO USE
#  1. Your filled-in copy must be named exactly  .env.local  and sit in the app
#     folder, next to package.json. (If this file is .env.example, copy it to .env.local.)
#  2. Fill in values after the = sign. No spaces around =, no quotes needed.
#  3. NEVER upload .env.local, email it, or paste it into a chat.
#     (.env.local is already blocked from GitHub.)
# ============================================================

# --- START HERE ---
# You can try the app on your computer with everything blank: it uses demo lyrics,
# skips payment and plays a test jingle. Fill these in as you get each account.

# Claude writes the real lyrics. Get it at console.anthropic.com > API Keys
# A real key starts with sk-ant-api03-  (blank = demo lyrics on your computer)
ANTHROPIC_API_KEY=

# Password for your dashboard at /admin (make up a long one)
ADMIN_PASSWORD=

# Your site address. Keep this for local testing; change it to your domain when live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the site for customer support
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_BUSINESS_NAME=SongGift


# --- PAYMENTS: Paystack ---

# dashboard.paystack.com > Settings > API Keys & Webhooks > Secret Key
# Test key starts with sk_test_  (use this first), live key starts with sk_live_
# Blank = payment is skipped while testing on your computer.
PAYSTACK_SECRET_KEY=

# Currency: USD, NGN, GHS, ZAR or KES
# USD only works if Paystack has enabled dollar payments on your account.
NEXT_PUBLIC_CURRENCY=USD

# Prices in whole units of your currency (e.g. 15000 = ₦15,000).
# Leave both blank for USD to use $29 and $49. REQUIRED for any other currency.
NEXT_PUBLIC_PRICE_STANDARD=
NEXT_PUBLIC_PRICE_DELUXE=

# Promo codes (optional): CODE:PERCENT_OFF or CODE:PERCENT_OFF:MAX_USES, comma-separated
# 100 = free song, no payment. Example: PROMO_CODES=FAMILY:100:30,MERRY20:20
PROMO_CODES=

# Revenue goal shown on your dashboard, in whole units of your currency
REVENUE_GOAL=200000


# --- NEEDED TO SELL (leave blank while testing) ---

# Real songs with vocals. elevenlabs.io > Profile > API Keys
# Blank = plays a short test jingle instead.
ELEVENLABS_API_KEY=

# "Your song is ready" emails. resend.com > API Keys (starts with re_)
RESEND_API_KEY=
EMAIL_FROM=SongGift <songs@yourdomain.com>


# --- ONLY FOR THE LIVE SITE (Vercel fills these in for you) ---

# Vercel > Storage > Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel > Storage > Blob
BLOB_READ_WRITE_TOKEN=


# --- OPTIONAL: ad tracking ---

# Meta Events Manager > your pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Ads Manager > Assets > Events > your pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
