# Claude writes the lyrics (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs Music renders the song with vocals (https://elevenlabs.io). Without it, dev mode plays a placeholder jingle.
ELEVENLABS_API_KEY=

# Paystack payments: dashboard.paystack.com > Settings > API Keys & Webhooks.
# Use the SECRET key: sk_test_... while testing, sk_live_... when you go live. Without it, local dev skips payment.
PAYSTACK_SECRET_KEY=

# Currency: USD, NGN, GHS, ZAR or KES. Charging in USD needs Paystack to enable dollar payments on your account.
NEXT_PUBLIC_CURRENCY=USD
# Prices in whole units of the currency (e.g. 15000 = ₦15,000). Leave blank for USD to use $29 / $49.
# Required for any other currency.
NEXT_PUBLIC_PRICE_STANDARD=
NEXT_PUBLIC_PRICE_DELUXE=

# Promo codes, comma-separated: CODE:PERCENT_OFF or CODE:PERCENT_OFF:MAX_USES. 100% off skips payment.
# Example: PROMO_CODES=FAMILY:100:30,MERRY20:20
PROMO_CODES=

# Order storage (Upstash Redis). Without it, orders are saved to .data/ locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Audio file storage (Vercel Blob). Without it, audio is saved to .data/ locally.
BLOB_READ_WRITE_TOKEN=

# "Your song is ready" emails (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="SongGift <songs@yourdomain.com>"

# Public URL of the site, used in emails, QR codes and the Paystack return link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the /admin dashboard (orders, revenue, sales by source, retry failed songs)
ADMIN_PASSWORD=
# Revenue goal shown on the dashboard, in whole units of your currency
REVENUE_GOAL=200000

# Shown in the footer, legal pages and error messages
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_BUSINESS_NAME=SongGift

# Ad pixels (optional). Fire Lead, InitiateCheckout and Purchase events.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
